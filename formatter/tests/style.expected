{ config, lib, pkgs, root, osConfig ? null, ... }:
{
  shortList = [ "one" "two" "three" ];
  mediumList = [
    "one"
    "two"
    "three"
    "four"
  ];
  longList = [
    "one"
    "two"
    "three"
    "four"
    "five"
    "six"
    "seven"
  ];
  commentedList = [
    "one"
    # Keep this grouping.
    "two"
  ];

  shortSet = {
    first = 1;
    second = lib.id 2;
  };
  longSet = {
    first = 1;
    second = 2;
    third = 3;
  };
  nestedSet = { outer = { inner = true; }; };

  enabled = true;  # exactly two spaces
  literal = "not # a comment";
}
