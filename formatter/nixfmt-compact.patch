+-- Project style: short, simple collections may stay on one line.
+--
+-- Keep a modest item limit in addition to the global width limit so mutable
+-- collections do not become excessively dense. Comments and other trivia
+-- introduce hard line breaks in their own pretty-printers, preventing
+-- contraction even when the item-count predicate succeeds.
+canCompactList :: Items Term -> Bool
+canCompactList items =
+  length (unItems items) <= 3 && all (isSimple . Term) items
+
+canCompactSet :: Items Binder -> Bool
+canCompactSet (Items items) =
+  length items == 1 && all isBinding items
+  where
+    isBinding (Item _) = True
+    isBinding (Comments _) = False
+
+-- Width-based compaction should not depend on how the collection was
+-- previously broken across lines in the input.
+ignoreSourceLayout :: Ann a -> Ann a
+ignoreSourceLayout a = a {sourceLine = pos1}
+
+compactBrackets :: Ann a -> Ann b -> (Ann a, Ann b)
+compactBrackets open close = (ignoreSourceLayout open, ignoreSourceLayout close)
+
