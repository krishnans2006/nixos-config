+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    #[test]
+    fn test_activity_name_tracks_workspace_independently_of_details() {
+        let mut config = Configuration::default();
+        config
+            .update(Some(serde_json::json!({
+                "name": "Working on {workspace}",
+                "details": "Using Zed",
+                "state": "Editing"
+            })))
+            .unwrap();
+
+        let nix = ActivityManager::build_activity_fields(
+            None,
+            &config,
+            "NixOS",
+            "/work/NixOS",
+            None,
+            None,
+        );
+        let other = ActivityManager::build_activity_fields(
+            None,
+            &config,
+            "Other",
+            "/work/Other",
+            None,
+            None,
+        );
+
+        assert_eq!(nix.name.as_deref(), Some("Working on NixOS"));
+        assert_eq!(other.name.as_deref(), Some("Working on Other"));
+        assert_eq!(nix.details.as_deref(), Some("Using Zed"));
+        assert_eq!(nix.state.as_deref(), Some("Editing"));
+        // A title change must invalidate the Discord activity cache.
+        assert_ne!(nix, other);
+    }
+
+    #[test]
+    fn test_activity_name_defaults_to_application_name_and_can_be_cleared() {
+        let mut config = Configuration::default();
+        assert!(config.activity.name.is_none());
+
+        config
+            .update(Some(
+                serde_json::json!({ "name": "Working on {workspace}" }),
+            ))
+            .unwrap();
+        config
+            .update(Some(serde_json::json!({ "name": null })))
+            .unwrap();
+
+        let fields = ActivityManager::build_activity_fields(
+            None,
+            &config,
+            "NixOS",
+            "/work/NixOS",
+            None,
+            None,
+        );
+        assert!(fields.name.is_none());
+    }
+
+    #[test]
+    fn test_workspace_name_overrides_support_set_clear_and_inherit() {
+        let mut config = Configuration::default();
+        config
+            .update(Some(serde_json::json!({
+                "name": "Working on {workspace}",
+                "overrides": [
+                    { "match": { "paths": ["/work/"] }, "name": "Work: {workspace}" },
+                    { "match": { "paths": ["/private/"] }, "name": null }
+                ]
+            })))
+            .unwrap();
+
+        for (path, expected) in [
+            ("/work/NixOS", Some("Work: NixOS")),
+            ("/private/NixOS", None),
+            ("/personal/NixOS", Some("Working on NixOS")),
+        ] {
+            let fields =
+                ActivityManager::build_activity_fields(None, &config, "NixOS", path, None, None);
+            assert_eq!(fields.name.as_deref(), expected);
+        }
+    }
+
+    #[test]
+    fn test_idle_name_resolves_workspace_separately() {
+        let mut config = Configuration::default();
+        config
+            .update(Some(serde_json::json!({
+                "name": "Working on {workspace}",
+                "idle": { "name": "Idling in {workspace}" }
+            })))
+            .unwrap();
+
+        let fields = ActivityManager::build_idle_activity_fields(None, &config, "NixOS", None);
+        assert_eq!(fields.name.as_deref(), Some("Idling in NixOS"));
+    }
+}
